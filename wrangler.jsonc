{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "heinssen-mlp-images-index",
    "preview_urls": false,
    "main": "worker.js",
    "compatibility_date": "2025-11-16",
    "vars": {
        "TAR_FILE_URL": "https://archive.org/download/heinessen-mlp-images/heinessen-mlp-images.tar",
        "INDEX_PATH": "/heinessen-mlp-images-index.bin",
        "INDEX_FILE_SIZE": "10172320"
    },
    "assets": {
        "binding": "INDEX",
        "not_found_handling": "404-page",
        "directory": "./static_assets",
        "run_worker_first": ["/image/*"]
    },
    "observability": {
        "enabled": true
    }
}